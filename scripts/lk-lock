#!/usr/bin/env python3
"""lk-lock LOCKFILE COMMAND [ARGS...]: run COMMAND while holding an exclusive lock on LOCKFILE (blocks until free).
macOS has no flock(1); this is the same thing on top of fcntl.flock. Used to serialize shared resources between
concurrent sessions: /tmp/lokinfer-build.lock (the shared build dir), /tmp/lokinfer-macbench.lock (Mac timing runs),
/tmp/lokinfer-phone.lock (iPhone sessions)."""
import fcntl
import subprocess
import sys

if len(sys.argv) < 3:
    sys.exit(__doc__)
with open(sys.argv[1], "a") as f:
    fcntl.flock(f, fcntl.LOCK_EX)
    sys.exit(subprocess.call(sys.argv[2:]))
