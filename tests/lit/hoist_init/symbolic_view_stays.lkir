// RUN: lokinfer-opt --pass=bufferize,hoist-init %s | filecheck %s

// A view of a constant typed with a per-call symbol (Kokoro: pos_table[0:T])
// stays in exec; the constant itself is hoisted.
// CHECK-LABEL: init -> buffer<f32[16, 4]> {
// CHECK:         const.internal @"pos"
// CHECK-NOT:     view
// CHECK-LABEL: exec(
// CHECK:         view %{{.*}}[0] : buffer<f32[T, 4]>
model {
  init {
    return
  }
  exec(%x: tensor<f32[T, 4]>) {
    %p = const.internal @"pos" : tensor<f32[16, 4]>
    %v = view %p[0] : tensor<f32[T, 4]>
    %o = kernel "add_f32_cpu"(%x, %v) : tensor<f32[T, 4]>
    return %o
  }
}
